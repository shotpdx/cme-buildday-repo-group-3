# ============================================================================
# Creative Command Center - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: Replace all placeholder values below before running deployment!
# ============================================================================

# ---------------------------------------------------------------------------
# REQUIRED: Databricks Workspace Configuration
# ---------------------------------------------------------------------------

# Your Databricks workspace URL (required)
# Example: https://dbc-abc123-def4.cloud.databricks.com
DATABRICKS_HOST=https://YOUR_WORKSPACE.cloud.databricks.com

# Personal Access Token (required if not using OAuth)
# To create: Databricks UI → Settings → Developer → Access tokens → Generate
DATABRICKS_TOKEN=YOUR_TOKEN_HERE

# SQL Warehouse ID (required for SQL operations)
# To find: Databricks UI → SQL → SQL Warehouses → Click warehouse → Copy ID from URL
# Example URL: /sql/warehouses/abc123def456 → ID is "abc123def456"
DATABRICKS_WAREHOUSE_ID=YOUR_WAREHOUSE_ID

# ---------------------------------------------------------------------------
# OPTIONAL: Override Defaults
# ---------------------------------------------------------------------------

# Unity Catalog settings (defaults work for most deployments)
# PIPELINE_CATALOG=cme_outcomes_uswest
# PIPELINE_SCHEMA=lakefoundry

# App name (change if deploying multiple instances)
# APP_NAME=creative-command-center-dev

# Deployment target (dev or prod)
# DATABRICKS_TARGET=dev
