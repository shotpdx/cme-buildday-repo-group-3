{
  "name": "apertureiq-command-center",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,green \"PYTHONDONTWRITEBYTECODE=1 python3 -m uvicorn app.main:app --reload --host 127.0.0.1 --port 8000\" \"vite --host 127.0.0.1 --port 5173\"",
    "dev:api": "PYTHONDONTWRITEBYTECODE=1 python3 -m uvicorn app.main:app --reload --host 127.0.0.1 --port 8000",
    "dev:web": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc --noEmit && vite build",
    "start": "PYTHONDONTWRITEBYTECODE=1 python3 -m app.main",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@types/d3-geo": "^3.1.0",
    "@types/topojson-client": "^3.1.5",
    "d3-geo": "^3.1.1",
    "framer-motion": "^12.23.26",
    "lucide-react": "^1.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.5.1",
    "topojson-client": "^3.1.0",
    "us-atlas": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.17",
    "concurrently": "^9.2.1",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^7.3.0"
  }
}
